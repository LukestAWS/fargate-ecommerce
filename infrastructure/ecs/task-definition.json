{
    "family": "orders-service-task",
    "executionRoleArn": "arn:aws:iam::247523262683:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
        {
            "name": "orders-container",
            "image": "247523262683.dkr.ecr.us-east-1.amazonaws.com/orders-service:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "DB_HOST",
                    "value": "fargate-db.ceb4mwm2oo0m.us-east-1.rds.amazonaws.com"
                },
                {
                    "name": "DB_PORT",
                    "value": "5432"
                },
                {
                    "name": "DB_USER",
                    "value": "lukest_admin"
                },
                {
                    "name": "DB_PASSWORD",
                    "value": "YourSecurePassword123"
                }
            ]
        }
    ]
}
