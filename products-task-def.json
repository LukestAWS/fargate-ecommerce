{
  "family": "fargate-ecommerce-products",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::247523262683:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "products",
      "image": "247523262683.dkr.ecr.us-east-1.amazonaws.com/fargate-ecommerce-products:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fargate-ecommerce-products",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}